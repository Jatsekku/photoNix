function stripWaveguide_draw(wg) {
    # Bring SI prefixes to the scope
    siConst;

    addstructuregroup;
    set("name", wg.name);

    # Group center
    # X
    if (!isfield(wg, "x")) { wg.x = 0; }
    set("x", wg.x);

    # Y
    if (!isfield(wg, "y")) { wg.y = 0; }
    set("y", wg.y);

    # Z
    if (!isfield(wg, "z")) { wg.z = 0; }    
    set("z", wg.z);

    ################################# Clad ####################################
    addrect;
    set("name", "clad");

    # Width
    if (!isfield(wg, "clad_width")) { wg.clad_width = wg.core_width * 8; }
    set("x", 0);
    set("x span", wg.clad_width);

    # Length
    set("y min", 0);
    set("y max", wg.length);

    # Thickness
    if (!isfield(wg, "clad_thickness")) { wg.clad_thickness = wg.core_thickness * 8; }
    set("z", 0);
    set("z span", wg.clad_thickness);

    if (!isfield(wg, "clad_material")) { wg.clad_material = "SiO2 (Glass) - Palik"; } 
    set("material", wg.clad_material);

    addtogroup(wg.name);

    ################################# Core ####################################
    addrect;
    set("name", "core");

    # Width
    if (!isfield(wg, "core_width")) { wg.core_width = 500*nm; } 
    set("x", 0);
    set("x span", wg.core_width);

    # Length
    if (!isfield(wg, "length")) { wg.length = 3*um; } 
    set("y min", 0);
    set("y max", wg.length);

    # Thickness
    if (!isfield(wg, "core_thickness")) { wg.core_thickness = 220*nm; } 
    set("z min", 0);
    set("z max", wg.core_thickness);

    if (!isfield(wg, "core_material")) { wg.core_material = "Si (Silicon) - Palik"; } 
    set("material", wg.core_material);

    addtogroup(wg.name);

    groupscope("::model");
}
